---
import Button from '../ui/Button.astro';
import { getDownloadState } from '../../utils/releaseState';
import type { ReleaseArtifactData } from '../../content/config/releases';

export interface Props {
  release: ReleaseArtifactData;
  releasesUrl: string;
}

const { release, releasesUrl } = Astro.props;
const downloadState = getDownloadState(release);

const platformLabels: Record<string, string> = {
  windows: 'Windows',
  macos: 'macOS',
  linux: 'Linux',
};
---

<div
  class="rounded-base border-border bg-surface-elevated flex flex-col justify-between border p-6"
>
  <div>
    <h3 class="font-display text-text-primary text-lg font-semibold">
      {platformLabels[release.platform]}
      {release.architecture && <span class="text-text-muted">({release.architecture})</span>}
    </h3>
    <p class="text-text-secondary mt-1 text-sm">{release.format}</p>

    {
      release.version ? (
        <p class="text-text-secondary mt-3 text-sm">Version {release.version}</p>
      ) : (
        <p class="text-text-muted mt-3 text-sm">No build published for this architecture yet.</p>
      )
    }
  </div>

  <div class="mt-6">
    {
      downloadState === 'download' ? (
        <Button href={release.downloadUrl!} variant="primary" class="w-full">
          Download
        </Button>
      ) : (
        <Button
          href={releasesUrl}
          variant="secondary"
          class="w-full"
          target="_blank"
          rel="noopener noreferrer"
        >
          Check GitHub Releases
        </Button>
      )
    }
  </div>
</div>
