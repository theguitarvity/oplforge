---
import Button from '../ui/Button.astro';
import { getDownloadState } from '../../utils/releaseState';
import type { ReleaseArtifactData } from '../../content/config/releases';

export interface Props {
  release: ReleaseArtifactData;
  releasesUrl: string;
}

const { release, releasesUrl } = Astro.props;
const downloadState = getDownloadState(release);

const platformLabels: Record<string, string> = {
  windows: 'Windows',
  macos: 'macOS',
  linux: 'Linux'
};
---

<div class="flex flex-col justify-between rounded-base border border-border bg-surface-elevated p-6">
  <div>
    <h3 class="font-display text-lg font-semibold text-text-primary">
      {platformLabels[release.platform]}
      {release.architecture && <span class="text-text-muted">({release.architecture})</span>}
    </h3>
    <p class="mt-1 text-sm text-text-secondary">{release.format}</p>

    {
      release.version ? (
        <p class="mt-3 text-sm text-text-secondary">Version {release.version}</p>
      ) : (
        <p class="mt-3 text-sm text-text-muted">No stable release published yet.</p>
      )
    }
  </div>

  <div class="mt-6">
    {
      downloadState === 'download' ? (
        <Button href={release.downloadUrl!} variant="primary" class="w-full">
          Download
        </Button>
      ) : (
        <Button href={releasesUrl} variant="secondary" class="w-full" target="_blank" rel="noopener noreferrer">
          Check GitHub Releases
        </Button>
      )
    }
  </div>
</div>
