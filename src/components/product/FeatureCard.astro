---
import StatusBadge from '../product/StatusBadge.astro';
import type { FeatureData } from '../../content/config/features';

export interface Props {
  feature: FeatureData;
}

const { feature } = Astro.props;
---

<article class="rounded-base border border-border bg-surface-elevated p-6 transition-colors hover:border-primary/40">
  <div class="flex items-start justify-between gap-3">
    <h3 class="font-display text-lg font-semibold text-text-primary">{feature.title}</h3>
    <StatusBadge status={feature.status} />
  </div>
  <p class="mt-2 text-sm text-text-secondary">{feature.summary}</p>
</article>
