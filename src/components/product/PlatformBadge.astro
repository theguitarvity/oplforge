---
export type PlatformId = 'windows' | 'macos' | 'linux' | 'android';

export interface Props {
  platform: PlatformId;
  status?: 'AVAILABLE' | 'PLANNED';
  class?: string;
}

const { platform, status = 'AVAILABLE', class: className = '' } = Astro.props;

const labels: Record<PlatformId, string> = {
  windows: 'Windows',
  macos: 'macOS',
  linux: 'Linux',
  android: 'Android'
};
---

<span
  data-platform={platform}
  data-status={status}
  class:list={[
    'inline-flex items-center gap-1.5 rounded-base border px-3 py-1.5 text-sm font-medium',
    status === 'AVAILABLE'
      ? 'border-border bg-surface-elevated text-text-primary'
      : 'border-border/60 bg-surface-container/50 text-text-muted',
    className
  ]}
>
  {labels[platform]}
  {status === 'PLANNED' && <span class="text-xs text-text-muted">(Planned)</span>}
</span>
