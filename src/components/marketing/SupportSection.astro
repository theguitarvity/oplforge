---
import Container from '../ui/Container.astro';
import Button from '../ui/Button.astro';
import { site } from '../../content/config/site';

const patreonLink = site.links.find((link) => link.id === 'patreon');
const showPatreon = Boolean(patreonLink?.visible);
---

<section class="border-b border-border py-16" id="support">
  <Container>
    <h2 class="font-display text-3xl font-bold text-text-primary">Support development</h2>
    <p class="mt-2 max-w-2xl text-text-secondary">
      OPL Forge is fully usable without paying anything, and always will be. If you'd like to
      help fund development time, testing hardware, or infrastructure, that's welcome —
      <strong class="text-text-primary">optional and never required</strong> to use any feature.
    </p>

    {
      showPatreon && patreonLink && (
        <div class="mt-6">
          <Button href={patreonLink.url} variant="secondary" target="_blank" rel="noopener noreferrer">
            Support on Patreon
          </Button>
        </div>
      )
    }
  </Container>
</section>
