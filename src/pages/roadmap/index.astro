---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/ui/Container.astro';
import StatusBadge from '../../components/product/StatusBadge.astro';
import { roadmap } from '../../content/config/roadmap';
---

<BaseLayout
  title="Roadmap"
  description="What's planned for OPL Forge — an honest, no-fabricated-features look ahead."
>
  <section class="py-16">
    <Container>
      <h1 class="font-display text-3xl font-bold text-text-primary">Roadmap</h1>
      <p class="mt-2 max-w-2xl text-text-secondary">
        Real, factual status for what's ahead — no invented features or timelines.
      </p>

      <ul class="mt-8 flex flex-col gap-4">
        {
          roadmap.map((item) => (
            <li class="rounded-base border border-border bg-surface-elevated p-6">
              <div class="flex flex-wrap items-center gap-3">
                <h2 class="font-display text-lg font-semibold text-text-primary">{item.title}</h2>
                <StatusBadge status={item.status} />
              </div>
              <p class="mt-2 text-sm text-text-secondary">{item.description}</p>
            </li>
          ))
        }
      </ul>
    </Container>
  </section>
</BaseLayout>
